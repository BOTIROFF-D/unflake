{
  "name": "unflake",
  "version": "0.3.0",
  "description": "Deterministic simulation testing for TypeScript. Find async races, deadlocks and lost retries, reproduce them from a seed, and exhaustively prove small tests correct.",
  "keywords": [
    "deterministic",
    "simulation",
    "testing",
    "flaky",
    "race-condition",
    "deadlock",
    "concurrency",
    "async",
    "fault-injection",
    "property-testing"
  ],
  "license": "MIT",
  "author": "BOTIROFF-D",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BOTIROFF-D/unflake.git"
  },
  "homepage": "https://github.com/BOTIROFF-D/unflake#readme",
  "bugs": "https://github.com/BOTIROFF-D/unflake/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples": "vitest run examples",
    "audit:contracts": "vitest run --config vitest.audit.config.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "async-mutex": "^0.5.0",
    "async-sema": "^3.1.1",
    "bottleneck": "^2.19.5",
    "generic-pool": "^3.9.0",
    "p-limit": "^7.3.1",
    "p-queue": "^9.3.3",
    "p-retry": "^8.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
